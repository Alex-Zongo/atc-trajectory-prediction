# Run artefacts. These are anchored to the repository root with a leading slash:
# an unanchored "data/" would also match src/atc_forecast/data/, which is source code.
/data/
/results/
/runs/
/wandb/
/.tmp/
*.pt
*.npz

# Dataset tables live under the ignored directories above, so parquet/CSV are not
# ignored globally; that would also hide any fixture a test needs to commit.

# Release assets staged by scripts/artifacts.py
/.artifacts/
