__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
.ipynb_checkpoints/

# Run artefacts. These are anchored to the repository root with a leading slash:
# an unanchored "data/" would also match src/atc_forecast/data/, which is source code.
/data/
/results/
/runs/
/wandb/
/.tmp/
*.pt
*.npz

# Dataset tables live under the ignored directories above, so parquet/CSV are not
# ignored globally; that would also hide any fixture a test needs to commit.

# Release assets staged by scripts/artifacts.py
/.artifacts/

# Private working notes (future directions, drafts).
/notes/

# v2 figures, paper drafts and exploration stay private until the paper is out. Only what
# another team needs to understand, evaluate and extend the models is tracked.
/figures/v2/
/paper/
/output/
/gpt_discussion_summary.md
/scripts/export_*.py
/scripts/explore_*.py

# Demo bundle (derived from the gated dataset) and the assembled Space folder
/demo/bundle/
/demo/space/
